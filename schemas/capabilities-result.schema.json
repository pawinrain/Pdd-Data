{
  "$defs": {
    "DatasetCapabilityDetail": {
      "additionalProperties": false,
      "properties": {
        "current_only": {
          "default": false,
          "title": "Current Only",
          "type": "boolean"
        },
        "entity_granularity": {
          "enum": [
            "STORE",
            "ACCOUNT",
            "CAMPAIGN",
            "PROMOTED_PRODUCT",
            "PRODUCT",
            "SKU",
            "UNKNOWN"
          ],
          "title": "Entity Granularity",
          "type": "string"
        },
        "limitation": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limitation"
        },
        "status": {
          "enum": [
            "SYNTHETIC_TEST_ONLY",
            "REAL_PROMOTION_TODAY",
            "REAL_PROMOTION_WINDOWS",
            "REAL_PROMOTED_PRODUCT_METRICS",
            "REAL_PROMOTION_CONFIGURATION_CURRENT",
            "REAL_STORE_TODAY",
            "REAL_PRODUCT_CATALOG",
            "REAL_INVENTORY",
            "CONFIGURED_NOT_VERIFIED",
            "UNAVAILABLE"
          ],
          "title": "Status",
          "type": "string"
        },
        "supported_window_kinds": {
          "items": {
            "$ref": "#/$defs/WindowKind"
          },
          "title": "Supported Window Kinds",
          "type": "array"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "entity_granularity"
      ],
      "title": "DatasetCapabilityDetail",
      "type": "object"
    },
    "WindowKind": {
      "enum": [
        "TODAY",
        "YESTERDAY",
        "LAST_7_DAYS",
        "LAST_30_DAYS",
        "LAST_90_DAYS",
        "POINT_IN_TIME",
        "CUSTOM",
        "UNKNOWN"
      ],
      "title": "WindowKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset_details": {
      "additionalProperties": {
        "$ref": "#/$defs/DatasetCapabilityDetail"
      },
      "title": "Dataset Details",
      "type": "object"
    },
    "datasets": {
      "additionalProperties": {
        "enum": [
          "SYNTHETIC_TEST_ONLY",
          "REAL_PROMOTION_TODAY",
          "REAL_PROMOTION_WINDOWS",
          "REAL_PROMOTED_PRODUCT_METRICS",
          "REAL_PROMOTION_CONFIGURATION_CURRENT",
          "REAL_STORE_TODAY",
          "REAL_PRODUCT_CATALOG",
          "REAL_INVENTORY",
          "CONFIGURED_NOT_VERIFIED",
          "UNAVAILABLE"
        ],
        "type": "string"
      },
      "title": "Datasets",
      "type": "object"
    },
    "real_collection": {
      "enum": [
        "DISABLED",
        "CONFIGURED_NOT_VERIFIED",
        "AVAILABLE"
      ],
      "title": "Real Collection",
      "type": "string"
    },
    "service": {
      "const": "pdd-data-mcp",
      "default": "pdd-data-mcp",
      "title": "Service",
      "type": "string"
    },
    "storage": {
      "const": "local_files",
      "default": "local_files",
      "title": "Storage",
      "type": "string"
    },
    "synthetic_test_mode": {
      "title": "Synthetic Test Mode",
      "type": "boolean"
    },
    "transport": {
      "const": "stdio",
      "default": "stdio",
      "title": "Transport",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "version",
    "synthetic_test_mode",
    "real_collection",
    "datasets"
  ],
  "title": "CapabilitiesResult",
  "type": "object"
}
